<?xml version="1.0" encoding="UTF-8"?>
<!-- Sample launchd job for macOS.
     Install:
       cp target/release/meta-agents-server /usr/local/bin/
       cp deploy/com.meta-agents.server.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.meta-agents.server.plist
     Logs: /tmp/meta-agents-server.log -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meta-agents.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/meta-agents-server</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>META_AGENTS_HTTP_ADDR</key>
    <string>127.0.0.1:7700</string>
    <key>META_AGENTS_TCP_ADDR</key>
    <string>127.0.0.1:7701</string>
    <key>META_AGENTS_UDP_ADDR</key>
    <string>127.0.0.1:7702</string>
    <key>RUST_LOG</key>
    <string>meta_agents_server=info</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/meta-agents-server.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/meta-agents-server.log</string>
</dict>
</plist>
